# Integração V3 com NestJS. A URL fica somente no servidor Next.js.
NEXT_PUBLIC_DATA_MODE=api
BACKEND_API_URL=http://127.0.0.1:3000

# Defina true junto com NEXT_PUBLIC_DATA_MODE=demo somente para builds de prévia autorizados.
# O valor é aplicado na compilação. Em builds comuns, deixe como false.
NEXT_PUBLIC_MAGICLED_PREVIEW=false

# Modo legado para testes históricos da V2.
# MAGICLED_ENABLE_LEGACY_API=false
# ENABLE_TEST_CHECKOUT=false
